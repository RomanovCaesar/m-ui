# Published image tag. Use a fixed release tag in production after images are available.
MUI_IMAGE_TAG=latest

# Used only by `docker compose build` for the embedded m-ui version.
MUI_BUILD_VERSION=dev
MIHOMO_VERSION=1.19.33
MIHOMO_SHA256=386508bfb1c72c43b6a0eda73708ecdce82546581b0ebcb16366c53757c622b6

TZ=Asia/Hong_Kong
MUI_PANEL_PORT=2053
MUI_USERNAME=admin

# Empty values are generated securely on the first start and printed once in
# `docker compose logs m-ui`. Values are ignored after state.json is created.
MUI_PASSWORD=
MUI_PATH=
